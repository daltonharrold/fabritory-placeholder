# Example server block — point root at this folder.
server {
    listen 80;
    server_name fabritory.com www.fabritory.com;
    root /var/www/fabritory;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(css|js|svg)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml;
}
